# ============================================================================
# 📖 ObsiBook — Obsidian Web E-Book Reader 환경 변수 설정 (.env)
# ============================================================================

# 1. [필수] 호스트 서버의 옵시디언 볼트(Vault) 절대 경로
# - 컨테이너 내부에는 ':ro' (읽기 전용)으로 연결되어 원본 문서 수정/훼손이 100% 차단됩니다.
# - 시놀로지 NAS (Synology Drive 홈 폴더) 예시:
#   OBSIDIAN_VAULT_PATH=/volume1/homes/본인시놀로지ID/SynologyDrive/Obsidian
#   (또는 구버전 Drive 경로: /volume1/homes/본인시놀로지ID/Drive/Obsidian)
# - 일반 Linux / macOS / Windows 예시:
#   OBSIDIAN_VAULT_PATH=/Users/username/Documents/ObsidianVault
OBSIDIAN_VAULT_PATH=./sample_vault

# 2. [선택] 읽은 위치(스크롤 진행률), 책갈피, 독서 메모가 저장될 데이터 폴더 경로
# - 옵시디언 볼트 폴더와 완전히 분리되어 저장되므로 동기화 충돌이 절대 발생하지 않습니다.
DATA_HOST_PATH=./data

# 3. [선택] 웹 브라우저에서 접속할 외부 포트 번호 (기본값: 18505)
APP_PORT=18505

# 4. [선택] 서재 이름 (상단 헤더 및 브라우저 탭에 표시될 제목)
VAULT_TITLE="ObsiBook — 내 옵시디언 전자책 서재"

# 5. [선택] 서재 열람 비밀번호 잠금
# - 비워두면("") 비밀번호 입력 없이 즉시 서재가 열립니다.
# - 외부 도메인 연결 시 타인의 열람을 막으려면 원하는 비밀번호를 입력하세요.
APP_PASSWORD=""
APP_SECRET="change-this-secret-key-for-cookie-signing"

# 6. [선택] 시놀로지 NAS 사용자 권한 (기본값 PUID=1026, PGID=100)
PUID=1026
PGID=100

# 7. [선택] Cloudflare Tunnel 토큰 (compose.cloudflare.yaml 사용 시에만 입력)
CF_TUNNEL_TOKEN=""
